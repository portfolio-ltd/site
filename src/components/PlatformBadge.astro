---
interface Props {
  platform: 'ios' | 'android' | 'mac' | 'web';
  shaded?: boolean;
}

const labels: Record<Props['platform'], string> = {
  ios: 'iOS',
  android: 'Android',
  mac: 'Mac',
  web: 'Web',
};

const { platform, shaded = false } = Astro.props;
---

<span
  class:list={['platform-badge', { shaded }]}
  title={shaded ? `${labels[platform]} — not available right now` : undefined}
>
  {labels[platform]}
</span>

<style>
  .platform-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .platform-badge.shaded {
    background: var(--bg-subtle);
    color: var(--text-tertiary);
    opacity: 0.7;
  }
</style>
