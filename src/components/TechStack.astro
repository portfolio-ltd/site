---
interface Props {
  techStack: string[];
}

const { techStack } = Astro.props;
---

{
  techStack.length > 0 && (
    <div class="tech-stack">
      {techStack.map((t) => (
        <span class="chip">{t}</span>
      ))}
    </div>
  )
}

<style>
  .tech-stack {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
</style>
