---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const policies = await getCollection('privacy');
  return policies.map((policy) => ({
    params: { slug: policy.id },
    props: { policy },
  }));
}

const { policy } = Astro.props;
const { Content } = await render(policy);
---

<Base
  title={`${policy.data.app} Privacy Policy — Portfolio Ltd`}
  description={`Privacy policy for ${policy.data.app}.`}
>
  <article class="container privacy">
    <a class="back-link" href={`/apps/${policy.id}/`}>← Back to {policy.data.app}</a>
    <h1>{policy.data.app} Privacy Policy</h1>
    <p class="updated">Last updated: {policy.data.lastUpdated}</p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .privacy {
    max-width: 720px;
    padding-top: 56px;
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    margin-bottom: 24px;
    color: var(--text-secondary);
  }

  .privacy h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 8px;
  }

  .updated {
    color: var(--text-tertiary);
    font-size: 0.88rem;
    margin-bottom: 32px;
  }
</style>
